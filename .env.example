# Auth.js (NextAuth v5)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sentry (errors only). Dev test: SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=
SENTRY_ENVIRONMENT=
# Optional: source maps upload in CI
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

YOUTUBE_API_KEY=
# Google OAuth (YouTube social connect) — also accepts YOUTUBE_CLIENT_* aliases
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/social/oauth/youtube/callback

# Meta / Facebook Login (Instagram API with Facebook Login)
META_APP_ID=
META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:3000/api/social/oauth/instagram/callback

# Optional: dedicated key for encrypting social OAuth tokens (falls back to AUTH_SECRET)
# SOCIAL_OAUTH_ENCRYPTION_KEY=

# Pooler (app runtime, port 6543) — add ?pgbouncer=true for Supabase transaction pooler
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection (prisma db push / migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Если задан, админка: /admin?key=<значение> и те же key для /api/admin/*
ADMIN_SECRET=

# DeepSeek (OpenAI-совместимый API), только сервер
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Стоимость одной генерации сценария во внутреннем кошельке токенов
SCRIPT_GENERATION_TOKEN_COST=20
